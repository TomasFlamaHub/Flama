# Copiar a .env (local) o cargar como Secrets en GitHub Actions / Streamlit Cloud. NUNCA subir valores reales al repo.
DATABASE_URL=postgresql://usuario:clave@host:5432/postgres   # Supabase / Neon. Vacío = SQLite local
ANTHROPIC_API_KEY=                                            # Analista IA
APP_PASSWORD=                                                 # Contraseña del dashboard
DASHBOARD_URL=                                                # Link incluido en el email diario
# Justo API
JUSTO_API_BASE=
JUSTO_API_TOKEN=
# Buzón de reportes (IMAP, solo lectura)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_ALLOWED_SENDERS=
# Envío del resumen diario (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
